{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:web",
  "build": {"env": {"VITE_STORAGE_LABEL": "Vercel private Blob · attendly-records"}},
  "outputDirectory": "dist",
  "regions": ["bom1"],
  "rewrites": [{"source": "/((?!api/|assets/|models/).*)", "destination": "/index.html"}],
  "headers": [
    {"source": "/api/(.*)", "headers": [{"key": "Cache-Control", "value": "private, no-store"}]},
    {"source": "/models/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/(.*)", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}]}
  ]
}
